# ==================== PIPELINE IDIOMA (indice por idioma) ====================
# navega el catalogo paginado /idioma/<slug> (espanol-latino | japones)
# y, al elegir un anime, continua dentro del pipeline jkanime (reentrada)

pipeline_idioma() {

clear

local pag=1

while true; do

    rm -f resultados.txt

    curl -s -m 25 -A "$JK_UA" \
        "https://jkanime.net/idioma/$IDIOMA_BROWSE?p=$pag" \
        -o pagina_idioma.html 2>/dev/null

    grep -oP '<h5><a\s+href="[^"]*">\K.*?(?=</a></h5>)' pagina_idioma.html \
        | sed 's/&quot;//g' > resultados.txt

    rm -f pagina_idioma.html

    num_resultados=$(wc -l < resultados.txt 2>/dev/null || echo 0)

    if [ "$num_resultados" -eq 0 ]; then
        echo -e "${RED}No hay animes en '$IDIOMA_BROWSE' (pagina $pag).${NC}"
        read -rp "Presiona Enter para volver..." _
        ABORT=1
        IDIOMA_BROWSE=""
        return
    fi

    echo -e "Idioma: $GREEN $IDIOMA_BROWSE $WHITE | Pagina: $pag"
    echo -e "Resultados:"

    opcion=$( (cat "resultados.txt"; echo "Siguiente"; echo "Anterior"; echo "Salir"; echo "Salir del programa") | tac | fzf --prompt="Selecciona una opción: " --height=20 --border --info=inline --margin=1,1,0,0)

    if [[ "$opcion" == "Siguiente" ]]; then
        pag=$((pag + 1))
        continue
    elif [[ "$opcion" == "Anterior" ]]; then
        if [ "$pag" -gt 1 ]; then
            pag=$((pag - 1))
        fi
        continue
    elif [[ "$opcion" == "Salir" ]]; then
        ABORT=1
        IDIOMA_BROWSE=""
        return
    elif [[ "$opcion" == "Salir del programa" ]]; then
        SALIR=1
        ABORT=1
        IDIOMA_BROWSE=""
        return
    fi

    # seleccionado: continuar con el pipeline jkanime para ese titulo
    titulo_elegido="$opcion"
    oracion="$opcion"
    IDIOMA_BROWSE=""
    pipeline_jkanime
    return
done
}


# ==================== ENTRADA ====================

main() {

clear

check_dependencies wget fzf grep sed python3 mpv jq curl

while true; do
    ABORT=0

    if [ "$SALIR" == "1" ]; then
        break
    fi

    # -c sin termino: usa la busqueda pasada por argumentos en el primer ciclo
    if [ "$CONTINUE" == "1" ] && [ -z "$REENTRY" ] && [ -n "$arg1" ]; then
        REENTRY="jkanime|$arg1"
    fi

    limpiar_estado

    if [ -n "$REENTRY" ]; then
        _re="$REENTRY"
        REENTRY=""
        oracion="${_re#*|}"
    fi

    if [ -n "$IDIOMA_BROWSE" ]; then
        pipeline_idioma
    else
        pipeline_jkanime
    fi
done
}

main