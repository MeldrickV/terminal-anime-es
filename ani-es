#!/bin/bash

VERSION="1.5.1"

CONTINUE=0
progress="00:00:00"

# cosas para texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'

# cosas para el fondo del texto
BG_RED='\033[41m'
BG_GREEN='\033[42m'
BG_YELLOW='\033[43m'
BG_BLUE='\033[44m'
BG_PURPLE='\033[45m'
BG_CYAN='\033[46m'
BG_WHITE='\033[47m'


NC='\033[0m'

HISTORY_DIR="$HOME/ani-es"
OLD_DB="$HISTORY_DIR/history.db"
HISTORY_FILE="$HOME/ani-es/history.json"

JK_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"

# estado interno del flujo
SRC_REFERER=""
CMD_UA="$JK_UA"
ABORT=0
SALIR=0
REENTRY=""
# navegacion por idioma (/-i): espanol-latino | japones
IDIOMA_BROWSE=""


init_history() {

    mkdir -p "$HISTORY_DIR"

    if [[ ! -f "$HISTORY_FILE" ]] || [[ ! -s "$HISTORY_FILE" ]]; then
        echo "{}" > "$HISTORY_FILE"
    fi

    # si el archivo no es JSON válido (p. ej. por un corte a la mitad),
    # se regenera para que jq no falle en toda la sesión
    if ! jq empty "$HISTORY_FILE" > /dev/null 2>&1; then
        echo "{}" > "$HISTORY_FILE"
    fi

    if [[ -f "$OLD_DB" ]]; then

        echo
        echo "El sistema de guardado de historial ha cambiado."
        read -rp "¿Desea importar su antiguo historial? (y/n): " respuesta

        if [[ "$respuesta" =~ ^[YySs]$ ]]; then

            echo "Importando historial..."

            if python3 <<EOF
import sqlite3
import json

db_path = "$OLD_DB"
json_path = "$HISTORY_FILE"

try:
    with open(json_path, "r", encoding="utf-8") as f:
        history = json.load(f)
except:
    history = {}

conn = sqlite3.connect(db_path)
cursor = conn.cursor()

cursor.execute("""
SELECT name
FROM sqlite_master
WHERE type='table' AND name='animes'
""")

if cursor.fetchone():

    cursor.execute("SELECT anime,last_cap,progress FROM animes")

    for anime,last_cap,progress in cursor.fetchall():

        try:
            last_cap = int(last_cap)
        except (TypeError, ValueError):
            last_cap = 0

        if not progress:
            progress = "00:00:00"

        history[anime] = {
            "last_cap": last_cap,
            "progress": progress,
            "source": "jkanime"
        }

conn.close()

with open(json_path, "w", encoding="utf-8") as f:
    json.dump(history, f, indent=4, ensure_ascii=False)

EOF
            then
                rm -f "$OLD_DB"
                echo "Historial importado correctamente."
            else
                echo "Ha ocurrido un error durante la importación."
                echo "La base de datos antigua no se ha eliminado."
            fi

        else
            rm -f "$OLD_DB"
            echo "El historial antiguo ha sido eliminado."
        fi
    fi

    # La fuente AnimeFLV fue retirada; sus registros pasan a jkanime
    # para que "-c" siga funcionando sin tocar el pipeline eliminado.
    python3 <<EOF
import json

path = "$HISTORY_FILE"

try:
    with open(path, "r", encoding="utf-8") as f:
        history = json.load(f)
except Exception:
    history = {}

changed = False
for anime, data in list(history.items()):
    if isinstance(data, dict) and data.get("source") == "animeflv":
        data["source"] = "jkanime"
        changed = True

if changed:
    with open(path, "w", encoding="utf-8") as f:
        json.dump(history, f, indent=4, ensure_ascii=False)
EOF
}

init_history

clear
get_last_cap() {
    jq -r --arg anime "$1" \
        '.[$anime].last_cap // ""' \
        "$HISTORY_FILE"
}


get_progress() {
    jq -r --arg anime "$1" \
        '.[$anime].progress // "00:00:00"' \
        "$HISTORY_FILE"
}


save_history() {
    local anime="$1"
    local cap="$2"
    local progress="$3"
    local source="$4"

    # no guardar episodios vacíos ni corromper el historial
    if [ -z "$cap" ]; then
        return 0
    fi

    tmp=$(mktemp)

    if jq \
        --arg anime "$anime" \
        --arg cap "$cap" \
        --arg progress "$progress" \
        --arg source "$source" \
        '.[$anime] = {
            last_cap: (($cap|tonumber?) // 0),
            progress: $progress,
            source: $source
        }' \
        "$HISTORY_FILE" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$HISTORY_FILE"
    else
        rm -f "$tmp"
    fi
}
 

show_help() {
    echo ""
    echo "    Uso: ani-es [opciones] [busqueda]"
    echo ""
    echo "    Opciones:"
    echo "      -h, --help       Mostrar ayuda"
    echo "      -v, --version    Mostrar versión"
    echo "      -c, --continue   Continua el anime en donde ultimo lo dejaste"
    echo "      -i, --idioma ID  Lista los animes de un idioma (espanol-latino | japones)"
    echo ""
}

show_version() {
    echo -e "ani-es ${PURPLE}v${VERSION}${NC}"
}

# parseo de argumentos
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -c|--continue)
            CONTINUE=1
            ;;
        -i|--idioma)
            if [[ -n "$2" ]]; then
                IDIOMA_BROWSE="$2"
                shift
            fi
            ;;
        *)
            break
            ;;
    esac
    shift
done


arg1="$*"


check_dependencies() {
    local script_name
    script_name=$(basename "$0")
    local missing=()

    for cmd in "$@"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${CYAN}[$script_name]${RED} Dependencias faltantes:${NC}"
        for pkg in "${missing[@]}"; do
            echo -e "${CYAN}  - $pkg ${NC}"
        done
        echo -e "${GREEN}Ejecuta el instalador antes de usar este script.${NC}"
        exit 1
    fi
}

detect_env() {
    # WSL (1 o 2)
    if grep -qi microsoft /proc/version 2>/dev/null || [ -n "$WSL_DISTRO_NAME" ]; then
        echo "wsl"
    # Termux (Android)
    elif [ -n "$PREFIX" ] && [[ "$PREFIX" == *com.termux* ]]; then
        echo "termux"
    # Linux normal
    else
        echo "linux"
    fi
}

# ============ reproduccion compartida (jkanime) ============

reproducir() {
    local src_contenido="$1"
    local hdrs=""

    ENV=$(detect_env)
    pos=0

    if [ -n "$SRC_REFERER" ]; then
        hdrs="--user-agent=$CMD_UA --http-header-fields=\"Referer: $SRC_REFERER\""
    fi

    case "$ENV" in
        wsl)
            if command -v mpv.exe >/dev/null 2>&1; then
                pos=$(mpv.exe --start=$progress $hdrs --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$capi" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1  | sed 's/AV: //g' 2>&1)
            else
                echo "mpv.exe no encontrado en Windows PATH"
            fi
            ;;
        termux)
            if pm list packages | grep -q 'org.videolan.vlc'; then
                am start -a android.intent.action.VIEW -d "$src_contenido" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity
                pos=0
            else
                termux-open-url "$src_contenido"
                pos=0
            fi
            ;;
        linux)
            if command -v mpv >/dev/null 2>&1; then
                pos=$(mpv --start=$progress $hdrs -v --msg-level=ffmpeg=no --force-media-title="$titulo_elegido-$capi" "$src_contenido" | grep -oE 'AV: [0-9]{2}:[0-9]{2}:[0-9]{2}' | tail -n 1  | sed 's/AV: //g' 2>&1)
            fi
            ;;
    esac
}

# limpiar estado entre busquedas (sin tocar CONTINUE/ABORT/SALIR)
limpiar_estado() {
    oracion=""
    arg1=""
    query=""
    titulo_elegido=""
    slug=""
    capi=""
    opcion=""
    sel=""
    src_contenido=""
    SRC_REFERER=""
    progress="00:00:00"
    idioma=""
    idioma_label=""
}

# menu posterior a la reproduccion (compartido)
# requiere: ir_a_capitulo <numero> (definido por cada pipeline)
menu_post_reproduccion() {
    local op
    op=$( (echo "Siguiente"; echo "Retroceder"; echo "Atras"; echo "Salir del programa") | tac | fzf --prompt="Selecciona una opción: " --height=9 --border --info=inline --margin=1,1,0,0)

    if [[ "$op" == "Siguiente" ]]; then
        progress="00:00:00"
        capi=$((capi + 1))
        save_history "$titulo_elegido" "$capi" "$pos" "jkanime"
        ir_a_capitulo "$capi"
    elif [[ "$op" == "Retroceder" ]]; then
        progress="00:00:00"
        capi=$((capi - 1))
        ir_a_capitulo "$capi"
    elif [[ "$op" == "Atras" ]]; then
        ABORT=1
    elif [[ "$op" == "Salir del programa" ]]; then
        SALIR=1
        ABORT=1
    fi
}

